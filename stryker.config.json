{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.mutation.config.ts"
  },
  "mutate": [
    "src/**/*.ts",
    "!src/index.ts",
    "!src/types.ts",
    "!src/cli/blind.ts",
    "!src/cli/unblind.ts",
    "!src/cli/real-io.ts"
  ],
  "ignorePatterns": [
    "dist",
    "reports",
    "coverage",
    ".local",
    "ner/models",
    "ner/dist"
  ],
  "coverageAnalysis": "perTest",
  "reporters": [
    "clear-text",
    "progress",
    "json",
    "html"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "incremental": true,
  "incrementalFile": "reports/mutation/incremental.json",
  "concurrency": 8,
  "timeoutMS": 60000,
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "thresholds": {
    "high": 85,
    "low": 75,
    "break": 73
  },
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "ignoreStatic": true
}
